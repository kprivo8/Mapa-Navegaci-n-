<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mapa de Navegación - Estilo EMix Protegido</title>
    <style>
        :root {
            --bg-color: #121214;
            --card-bg: #1a1a1e;
            --text-color: #e1e1e6;
            --text-secondary: #a8a8b3;
            --border-color: #29292e;
            --hover-color: #202024;
            --accent-color: #00b37e;
            --accent-glow: rgba(0, 179, 126, 0.2);
            --accent-green: #04d361;
            --accent-green-bg: rgba(4, 211, 97, 0.15);
            --accent-yellow: #fba94c;
            --accent-yellow-bg: rgba(251, 169, 76, 0.15);
            --accent-yellow-glow: 0 0 15px rgba(251, 169, 76, 0.6), inset 0 0 10px rgba(251, 169, 76, 0.3);
            --accent-blue: #81d8f7;
            --accent-blue-bg: rgba(129, 216, 247, 0.1);
            --error-color: #f75a68;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            background-color: var(--bg-color);
            color: var(--text-color);
            margin: 0;
            padding: 40px 20px;
            display: flex;
            justify-content: center;
        }

        .notion-page {
            max-width: 800px;
            width: 100%;
        }

        .notion-header {
            margin-bottom: 30px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .notion-title {
            font-size: 32px;
            font-weight: 700;
            margin: 0 0 10px 0;
            color: #ffffff;
        }

        .lock-panel {
            background: var(--card-bg);
            border: 1px solid var(--border-color);
            padding: 10px 16px;
            border-radius: 8px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .lock-panel input {
            background: var(--bg-color);
            border: 1px solid var(--border-color);
            color: #fff;
            padding: 6px 10px;
            border-radius: 4px;
            outline: none;
            font-size: 13px;
        }

        .lock-panel button {
            background: var(--accent-color);
            color: #121214;
            border: none;
            padding: 6px 12px;
            border-radius: 4px;
            font-weight: 600;
            cursor: pointer;
        }

        .lock-panel button:hover {
            opacity: 0.9;
        }

        .status-msg {
            font-size: 12px;
            margin-top: 4px;
            color: var(--error-color);
        }

        .notion-icon-bar {
            display: grid;
            grid-template-columns: repeat(6, 1fr);
            gap: 10px;
            margin-bottom: 30px;
            background: var(--card-bg);
            padding: 10px;
            border-radius: 12px;
            border: 1px solid var(--border-color);
        }

        .icon-btn {
            background: var(--bg-color);
            border: 1px solid var(--border-color);
            border-radius: 8px;
            padding: 12px 4px;
            text-align: center;
            cursor: pointer;
            font-weight: 600;
            font-size: 11px;
            color: var(--text-secondary);
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 6px;
            transition: all 0.2s ease;
        }

        .icon-btn:hover {
            background: var(--hover-color);
            color: var(--text-color);
            border-color: var(--accent-color);
        }

        .icon-btn.active {
            background: var(--hover-color);
            color: #ffffff;
            border-color: var(--accent-color);
            box-shadow: 0 0 10px var(--accent-glow);
            font-weight: 700;
        }

        .icon-btn span {
            font-size: 24px;
        }

        .notion-card {
            display: none;
            border: 1px solid var(--border-color);
            border-radius: 12px;
            background: var(--card-bg);
            padding: 24px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.4);
        }

        .notion-card.active {
            display: block;
        }

        .card-title {
            font-size: 18px;
            font-weight: 700;
            margin: 0 0 20px 0;
            padding-bottom: 8px;
            border-bottom: 1px solid var(--border-color);
            text-transform: uppercase;
            letter-spacing: 0.5px;
            color: #ffffff;
        }

        .menu-list {
            display: flex;
            flex-direction: column;
            gap: 4px;
        }

        details {
            border-radius: 6px;
        }

        details summary {
            list-style: none;
            padding: 8px 12px;
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
            display: flex;
            align-items: center;
            border-radius: 6px;
            user-select: none;
            background-color: rgba(255, 255, 255, 0.02);
            color: var(--text-color);
        }

        details summary:hover {
            background-color: var(--hover-color);
            color: #ffffff;
        }

        details summary::before {
            content: "▶";
            display: inline-block;
            font-size: 9px;
            margin-right: 10px;
            color: var(--accent-color);
            transition: transform 0.2s ease;
        }

        details[open] summary::before {
            transform: rotate(90deg);
        }

        .toggle-content {
            padding: 6px 8px 6px 32px;
            display: flex;
            flex-direction: column;
            gap: 6px;
            border-left: 2px solid var(--border-color);
            margin-left: 16px;
            margin-top: 4px;
            margin-bottom: 4px;
        }

        .static-item {
            padding: 8px 12px;
            font-size: 14px;
            font-weight: 400;
            color: var(--text-color);
            border-radius: 6px;
        }

        .static-item:hover {
            background-color: var(--hover-color);
            color: #ffffff;
        }

        .badge {
            font-size: 13px;
            padding: 6px 10px;
            border-radius: 6px;
            display: block;
            margin-bottom: 2px;
            font-weight: 500;
        }
        .bg-green { background-color: var(--accent-green-bg); color: var(--accent-green); border: 1px solid rgba(4, 211, 97, 0.2); }
        .bg-yellow { background-color: var(--accent-yellow-bg); color: var(--accent-yellow); border: 1px solid rgba(251, 169, 76, 0.2); }
        .bg-blue { background-color: var(--accent-blue-bg); color: var(--accent-blue); border: 1px solid rgba(129, 216, 247, 0.2); }
        
        .bg-yellow-glow {
            background-color: var(--accent-yellow-bg);
            color: #fff;
            border: 1px solid var(--accent-yellow);
            box-shadow: var(--accent-yellow-glow);
            font-weight: 700;
        }
    </style>
</head>
